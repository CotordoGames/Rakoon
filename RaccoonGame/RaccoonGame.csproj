<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>

        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <InvariantGlobalization>true</InvariantGlobalization>

        <SelfContained>false</SelfContained>
        <PublishSingleFile>false</PublishSingleFile>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishAot>false</PublishAot>

        <PlatformTarget>AnyCPU</PlatformTarget>
    </PropertyGroup>

    <!-- Select a default RID based on the operating system.
         A RID supplied on the command line or by Rider takes precedence. -->
    <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>

    <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' != 'Windows_NT'">
        <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    </PropertyGroup>

    <PropertyGroup>
        <NativeLibDirectory>$(MSBuildProjectDirectory)/NativeLibs/$(RuntimeIdentifier)</NativeLibDirectory>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Raylib-cs" Version="8.1.0" />
    </ItemGroup>

    <!-- Copy all native files from NativeLibs/<runtime identifier>/ -->
    <ItemGroup Condition="Exists('$(NativeLibDirectory)')">
        <NativeRuntimeFiles Include="$(NativeLibDirectory)/**/*" />
    </ItemGroup>

    <Target Name="CopyNativeRuntimeFiles"
            AfterTargets="Build"
            Condition="'@(NativeRuntimeFiles)' != ''">

        <Copy
                SourceFiles="@(NativeRuntimeFiles)"
                DestinationFiles="@(NativeRuntimeFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
                SkipUnchangedFiles="true" />
    </Target>

    <!-- Copy the assets directory -->
    <ItemGroup>
        <None Include="assets/**/*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>%(Identity)</TargetPath>
        </None>
    </ItemGroup>


    <!-- Windows-only files -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
        <None Include="autumn.ico">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>

        <None Include="konfig.exe">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- ApplicationIcon is meaningful for Windows builds -->
    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
        <ApplicationIcon>autumn.ico</ApplicationIcon>
    </PropertyGroup>

    <!-- Helpful build message -->
    <Target Name="ShowBuildConfiguration" BeforeTargets="Build">
        <Message Importance="High"
                 Text="Building for RuntimeIdentifier: $(RuntimeIdentifier)" />
        <Message Importance="High"
                 Text="Native library directory: $(NativeLibDirectory)" />
    </Target>

</Project>
